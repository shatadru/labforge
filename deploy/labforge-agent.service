[Unit]
Description=LabForge agent (owns libvirt on this KVM host)
Documentation=https://github.com/OWNER/labforge
After=network-online.target
Wants=network-online.target

# Distros ship libvirt either as the modular split daemons (virtqemud on
# Fedora/RHEL 9+, with virtproxyd owning the client socket) or as the
# monolithic libvirtd (Debian and older releases). Order after whichever is
# present, but never Wants= a specific one: libvirtd.service and
# virtqemud.service Conflict= (as do libvirtd.socket and virtproxyd.socket),
# so pulling one in stops the other and restarts every running VM.
After=libvirtd.service virtqemud.service libvirtd.socket virtqemud.socket virtproxyd.socket

# Start only when at least one libvirt daemon is installed. The two checks are
# OR-ed ("|"), so this works whichever daemon the distro packages and is
# skipped cleanly (rather than failing) when neither is present.
ConditionPathExists=|/usr/lib/systemd/system/libvirtd.service
ConditionPathExists=|/usr/lib/systemd/system/virtqemud.service

[Service]
Type=simple
# System service: configuration lives under /etc, not in a user home.
EnvironmentFile=-/etc/labforge/labforge-agent.env
Environment=MODE=agent
Environment=AGENT_BIND=127.0.0.1
Environment=AGENT_PORT=8443
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/usr/lib/labforge
# Exec the interpreter with `-m`, not the venv's `uvicorn` console script: the
# script under /usr/lib is labelled lib_t, which has no SELinux domain
# transition, so the agent would run in init_t and be denied executing virsh.
# The interpreter is bin_t and transitions to unconfined_service_t.
ExecStart=/usr/lib/labforge/venv/bin/python -m uvicorn app.main:app --host ${AGENT_BIND} --port ${AGENT_PORT}
Restart=on-failure
RestartSec=2

# The agent needs libvirt and the VM storage; everything else is locked down.
User=labforge
Group=labforge
# Add your distro's QEMU group here if VM storage needs it (for example
# SupplementaryGroups=libvirt qemu, or libvirt kvm on Debian).
SupplementaryGroups=libvirt
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
