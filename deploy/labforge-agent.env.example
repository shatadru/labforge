# LabForge agent configuration (MODE=agent).
#
# Installed to /etc/labforge/labforge-agent.env by the package. systemd does not
# expand %h inside this file, so use absolute paths.

MODE=agent
AGENT_BIND=127.0.0.1
AGENT_PORT=8443
AGENT_NAME=labforge-host-01

# Required unless AGENT_BIND is loopback AND AGENT_ALLOW_ANONYMOUS=true.
# Generate one with: openssl rand -hex 32
AGENT_TOKEN=

# Explicit anonymous access is for local development only. Never enable it on a
# networked host.
AGENT_ALLOW_ANONYMOUS=false

# Paths on this host.
TEMPLATES_DIR=/usr/lib/labforge/cloud_init_templates
VM_STORAGE_PATH=/var/lib/libvirt/images
SSH_PUBLIC_KEYS_FILE=/etc/labforge/authorized_keys
TAILSCALE_AUTH_KEY_FILE=/etc/labforge/tailscale-authkey
TAILSCALE_LOGOUT_ON_DELETE=true
METRICS_ENABLED=true
