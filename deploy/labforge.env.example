# LabForge control plane configuration.
#
# Copy to ~/.config/labforge/labforge.env, or run deploy/install-local.sh which
# does it for you. systemd does NOT expand %h inside this file, so use absolute
# paths (install-local.sh replaces __HOME__ with your home directory).

MODE=control
HOST_MODE=local

# Start the agent in-process and talk to it on loopback. This is the
# single-system setup: one service, one env file, control and agent together.
LOCAL_AGENT=true
AGENT_BIND=127.0.0.1
AGENT_PORT=8443
# Leave empty with LOCAL_AGENT=true: a random token is generated at startup.
AGENT_TOKEN=

# --- Remote agent (multi-host) ---
# To drive a separate KVM host, set LOCAL_AGENT=false and use:
# HOST_MODE=remote
# AGENT_URL=http://kvm-host-1:8443
# AGENT_TOKEN=<openssl rand -hex 32>

# Paths (absolute; install-local.sh substitutes __HOME__).
TEMPLATES_DIR=__HOME__/labforge/backend/cloud_init_templates
VM_STORAGE_PATH=__HOME__/labforge/vms
SSH_PUBLIC_KEYS_FILE=__HOME__/.ssh/authorized_keys
TAILSCALE_AUTH_KEY_FILE=__HOME__/.config/labforge/tailscale-authkey
TAILSCALE_LOGOUT_ON_DELETE=true
RESOURCE_BUDGET_PERCENT=50
METRICS_ENABLED=true
