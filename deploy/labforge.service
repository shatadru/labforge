[Unit]
Description=LabForge control plane (UI and API)
Documentation=https://github.com/OWNER/labforge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# install-local.sh replaces __BACKEND__ and __VENV__ with absolute paths.
WorkingDirectory=__BACKEND__
EnvironmentFile=%h/.config/labforge/labforge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=__VENV__/bin/uvicorn app.main:app --host 127.0.0.1 --port 8899
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
